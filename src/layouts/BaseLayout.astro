---
import "../styles/global.css";
import Header from "../components/Header.astro";
import "../styles/miku.css";

declare const __FAVICON_VERSION__: string;

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "白衣の博客 · 组一辈子乐队吧！ ",
  description = "白衣整理的科创情报、工具配置与杂。"
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN" data-base={import.meta.env.BASE_URL}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg?v=${__FAVICON_VERSION__}`} />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.css" crossorigin="anonymous" />
    <title>{title}</title>
    <script is:inline>
      const savedTheme = localStorage.getItem("baiyi-theme");
      if (savedTheme === "light" || savedTheme === "dark") document.documentElement.setAttribute("data-theme", savedTheme);
    </script>
  </head>
  <body class="miku-theme">
    <Header />
    <slot />
    <footer class="site-footer">
      <div class="shell footer-note"><span>保持好奇，继续生长。</span><a href={`${import.meta.env.BASE_URL}#articles`}>再翻一篇 ↗</a></div>
      <div class="shell footer-inner">
        <span>© {new Date().getFullYear()} 由Atri与白衣开发与管理</span>
        <span>当前版本: Algebra-1 .All Rights Reserved.</span>
      </div>
    </footer>
    <script is:inline>
      const syncCommentTheme = () => {
        const theme = document.documentElement.dataset.theme || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.querySelectorAll('script[src="https://giscus.app/client.js"]').forEach(script => { script.dataset.theme = theme; });
        document.querySelectorAll('iframe.giscus-frame').forEach(frame => {
          frame.contentWindow?.postMessage({ giscus: { setConfig: { theme } } }, "https://giscus.app");
        });
      };
      const commentObserver = new MutationObserver(() => {
        document.querySelectorAll('iframe.giscus-frame:not([data-theme-bound])').forEach(frame => {
          frame.dataset.themeBound = "true";
          frame.addEventListener("load", syncCommentTheme);
          syncCommentTheme();
        });
      });
      commentObserver.observe(document.body, { childList: true, subtree: true });
      matchMedia("(prefers-color-scheme: dark)").addEventListener("change", syncCommentTheme);
      syncCommentTheme();
      const themeButton = document.querySelector("[data-theme-toggle]");
      themeButton?.addEventListener("click", () => {
        const current = document.documentElement.dataset.theme;
        const systemDark = matchMedia("(prefers-color-scheme: dark)").matches;
        const next = current ? (current === "dark" ? "light" : "dark") : (systemDark ? "light" : "dark");
        document.documentElement.dataset.theme = next;
        localStorage.setItem("baiyi-theme", next);
        syncCommentTheme();
      });
    </script>
  </body>
</html>
