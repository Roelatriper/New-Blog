---
interface Props {
  id: string;
  title: string;
  description: string;
  category: string;
  readingMinutes: number;
  accent?: "mint" | "violet" | "pink" | "ink";
  featured?: boolean;
  image?: string;
  imageAlt?: string;
  imageBlur?: number;
  imageBrightness?: number;
  imagePosition?: string;
}

const {
  id,
  title,
  description,
  category,
  readingMinutes,
  accent = "mint",
  featured = false,
  image,
  imageAlt = "",
  imageBlur = 10,
  imageBrightness = 0.62,
  imagePosition = "center"
} = Astro.props;
const href = `${import.meta.env.BASE_URL}articles/${id}/`;
const imageUrl = id === "me" ? `${import.meta.env.BASE_URL}images/miku/about.webp` : image
  ? (/^(https?:|data:)/.test(image) ? image : `${import.meta.env.BASE_URL}${image.replace(/^\/+/, "")}`)
  : undefined;
const imageStyle = id === "me" ? "--card-blur:0px;--card-brightness:1;--card-position:center;" : `--card-blur:${imageBlur}px;--card-brightness:${imageBrightness};--card-position:${imagePosition};`;
const glyph = category === "配置指南" ? "</>" : category === "基础原理" ? "{ }" : category === "科创情报" ? "✳" : "♪";
const coverSeed = [...id].reduce((total, character) => total + (character.codePointAt(0) ?? 0), 0);
const coverVariant = `cover-variant-${coverSeed % 6 + 1}`;
---

<article class:list={["article-card", { featured, "about-card": id === "me" }]} data-category={category}>
  <a href={href}>
    <div class:list={["card-art", `accent-${accent}`, { "has-image": imageUrl, [coverVariant]: !imageUrl }]} style={imageUrl ? imageStyle : undefined}>
      {imageUrl && <img class="card-image" src={imageUrl} alt={imageAlt} loading="lazy" decoding="async" />}
      {imageUrl && <span class="card-image-mask" aria-hidden="true"></span>}
      <span class="cover-label">{category}</span>
      {!imageUrl && <span class="cover-glyph" aria-hidden="true">{glyph}</span>}
      <span class="cover-tag" aria-hidden="true">{featured ? "精选笔记 / PINNED" : "白衣的笔记 / NOTES"}</span>
    </div>
    <div class="card-body">
      <div class="card-meta"><span>{featured ? "置顶 · " : ""}{category}</span></div>
      <h3>{title}</h3>
      <p>{description}</p>
      <div class="card-foot"><span>约 {readingMinutes} 分钟</span><span>阅读全文 →</span></div>
    </div>
  </a>
</article>
