---
interface Props {
  id: string;
  title: string;
  description: string;
  category: string;
  readingMinutes: number;
  accent?: "mint" | "violet" | "pink" | "ink";
  featured?: boolean;
}

const { id, title, description, category, readingMinutes, accent = "mint", featured = false } = Astro.props;
const href = `${import.meta.env.BASE_URL}articles/${id}/`;
---

<article class:list={["article-card", { featured }]} data-category={category}>
  <a href={href}>
    <div class:list={["card-art", `accent-${accent}`]}><strong>{title}</strong></div>
    <div class="card-body">
      <div class="card-meta"><span>{featured ? "置顶 · " : ""}{category}</span></div>
      <h3>{title}</h3>
      <p>{description}</p>
      <div class="card-foot"><span>约 {readingMinutes} 分钟</span><span>阅读全文 →</span></div>
    </div>
  </a>
</article>
