<button class="primary-button" type="button" data-open-quiz>帮我选择环境</button>

<div class="quiz-overlay" id="environmentQuiz" role="dialog" aria-modal="true" aria-labelledby="quizTitle">
  <div class="quiz-dialog">
    <div class="quiz-top">
      <span class="quiz-count" id="quizCount">问题 1 / 3</span>
      <button class="quiz-close" type="button" data-close-quiz aria-label="关闭">×</button>
    </div>
    <div class="quiz-body" id="quizBody"></div>
  </div>
</div>

<script is:inline>
  (() => {
    const overlay = document.querySelector("#environmentQuiz");
    const body = document.querySelector("#quizBody");
    const count = document.querySelector("#quizCount");
    if (!overlay || !body || !count) return;

    let current = 0;
    let answers = [];
    const questions = [
      {
        title: "你是否必须遵守指定环境？",
        help: "比赛、课程或团队的明确要求优先于个人偏好。",
        choices: [["是，有明确规定", "进入比赛兼容路线", "devcpp"], ["没有规定", "继续根据我的需求推荐", "free"]]
      },
      {
        title: "你愿意理解并配置编译器吗？",
        help: "通常需要 20–40 分钟，但会让你真正理解环境如何工作。",
        choices: [["先简单开始", "我想下载后尽快写题", "redpanda"], ["愿意折腾一下", "我想理解编辑器与编译器", "learn"]]
      },
      {
        title: "你需要完整的 Windows C++ IDE 吗？",
        help: "Visual Studio 功能完整，安装内容可从数 GB 到数十 GB。",
        choices: [["需要完整工具", "并且可以接受较大的占用", "visualstudio"], ["更看重轻量灵活", "我愿意使用 VS Code + MSYS2", "vscode"]]
      }
    ];
    const results = {
      devcpp: { icon: "🏁", name: "Dev-C++ 5.11", slug: "devcpp-competition", desc: "赛事兼容方案", reasons: [["规则一致", "按当届通知配置"], ["固定版本", "避免下错分支"], ["赛前演练", "提前验证标准"]] },
      redpanda: { icon: "🐼", name: "小熊猫 C++", slug: "redpanda-cpp", desc: "轻量、开箱即用的日常选择", reasons: [["体积轻巧", "安装负担较小"], ["内含 GCC", "无需单独拼装"], ["操作熟悉", "接近 Dev-C++"]] },
      visualstudio: { icon: "∞", name: "Visual Studio 2026", slug: "visual-studio-2026", desc: "完整的 Windows C++ 开发环境", reasons: [["完整 IDE", "项目与调试一体"], ["MSVC", "Windows 原生工具链"], ["按需安装", "工作负载可调整"]] },
      vscode: { icon: "⌘", name: "VS Code + MSYS2", slug: "vscode-msys2", desc: "理解工具链后的灵活选择", reasons: [["持续更新", "MSYS2 包管理"], ["职责清晰", "编辑器不等于编译器"], ["自由组合", "适合继续深入"]] }
    };

    const open = () => {
      current = 0;
      answers = [];
      renderQuestion();
      overlay.classList.add("open");
      document.body.style.overflow = "hidden";
    };
    const close = () => {
      overlay.classList.remove("open");
      document.body.style.overflow = "";
    };
    const renderQuestion = () => {
      const item = questions[current];
      count.textContent = `问题 ${current + 1} / 3`;
      body.innerHTML = `<div class="eyebrow">为你匹配环境</div><h2 id="quizTitle">${item.title}</h2><p>${item.help}</p><div class="choice-grid">${item.choices.map((choice) => `<button class="choice" type="button" data-value="${choice[2]}"><strong>${choice[0]}</strong><span>${choice[1]}</span></button>`).join("")}</div>${current ? '<button class="quiz-back" type="button" data-back>← 返回上一题</button>' : ""}`;
      body.querySelectorAll("[data-value]").forEach((button) => button.addEventListener("click", () => choose(button.dataset.value)));
      body.querySelector("[data-back]")?.addEventListener("click", () => { current--; answers.pop(); renderQuestion(); });
    };
    const choose = (value) => {
      answers.push(value);
      if (results[value]) return renderResult(value);
      current++;
      renderQuestion();
    };
    const renderResult = (key) => {
      const result = results[key];
      count.textContent = "推荐结果";
      body.innerHTML = `<div class="result"><div class="result-icon">${result.icon}</div><div class="eyebrow">为你推荐</div><h2>${result.name}</h2><p class="lede">${result.desc}</p><div class="reason-grid">${result.reasons.map((reason) => `<div class="reason"><strong>${reason[0]}</strong><span>${reason[1]}</span></div>`).join("")}</div><div class="button-row" style="justify-content:center"><button class="primary-button" type="button" data-accept>采用这条路线</button><button class="secondary-button" type="button" data-restart>重新选择</button></div></div>`;
      body.querySelector("[data-restart]")?.addEventListener("click", open);
      body.querySelector("[data-accept]")?.addEventListener("click", () => {
        close();
        window.dispatchEvent(new CustomEvent("baiyi:route", { detail: result }));
        const target = document.querySelector("#install");
        target?.scrollIntoView({ behavior: "smooth" });
      });
    };

    document.querySelectorAll("[data-open-quiz]").forEach((button) => button.addEventListener("click", open));
    overlay.querySelector("[data-close-quiz]")?.addEventListener("click", close);
    overlay.addEventListener("click", (event) => { if (event.target === overlay) close(); });
    document.addEventListener("keydown", (event) => { if (event.key === "Escape" && overlay.classList.contains("open")) close(); });
  })();
</script>
