---
const base = import.meta.env.BASE_URL;
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={base} aria-label="返回白衣博客首页" title="白衣的个人站标">
      <span class="brand-mark" aria-hidden="true">白</span>
      <span>白衣</span>
    </a>
    <nav class="site-nav" aria-label="主导航">
      <a href={base}>首页</a>
      <a href={`${base}#articles`}>文章</a>
      <a href={`${base}#about`}>关于</a>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="切换明暗主题" title="切换明暗主题">◐</button>
      <a class="nav-cta" href={`${base}articles/cpp-environment/`}>C++ 配置指南</a>
    </nav>
  </div>
</header>
