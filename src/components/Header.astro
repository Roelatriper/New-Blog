---
const base = import.meta.env.BASE_URL;
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={base} aria-label="返回白衣博客首页" title="AWA">
      <span class="brand-mark" aria-hidden="true"><img src={`${base}favicon.svg`} alt="" /></span>
      <span id="hitokoto">白衣の博客</span>
        <!-- 本例不能添加链接内容，放在此处只是因为此接口比较方便，也许能够解决大部分的需求-->
        <!-- 所以上面那个是什么意思，我怎么没看懂。 -->
      <script src="https://v1.hitokoto.cn/?encode=js&select=%23hitokoto" defer></script>
    </a>
    <nav class="site-nav" aria-label="主导航">
      <a href={base}>首页</a>
      <a href={`${base}#articles`}>文章</a>
      <a href={`${base}articles/me/`}>关于</a>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="切换明暗主题" title="切换明暗主题">◐</button>
      <a class="nav-cta" href={`${base}articles/cpp-environment/`}>C++ 配置指南</a>
    </nav>
  </div>
</header>
