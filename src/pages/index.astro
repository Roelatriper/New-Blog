---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";

const entries = (await getCollection("articles", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
const mainGuide = {
  id: "cpp-environment",
  data: {
    title: "Windows 下的 C++ 环境怎么选？",
    description: "先判断比赛兼容、折腾意愿和项目规模，再进入对应的安装路线。",
    category: "配置指南",
    readingMinutes: 12,
    accent: "ink" as const,
    featured: true,
    image: undefined,
    imageAlt: "",
    imageBlur: 10,
    imageBrightness: 0.62,
    imagePosition: "center"
  }
};
const cards = [mainGuide, ...entries];
---

<BaseLayout>
  <main class="home-main shell">
    <section class="home-hero" id="about">
      <div class="hero-copy">
        <div class="eyebrow">才子佳人，自是白衣卿相。</div>
        <h1>≽^•⩊•^≼</h1>
        <p class="lede">这里收录我整理的科创情报、工具配置和杂。挑感兴趣的读。</p>
      </div>
      <aside class="promise-card">
        <div class="eyebrow">本站正在生长</div>
        <strong>Divide<br />et impera.</strong>
        <p>分而治之。</p>
      </aside>
    </section>

    <section id="articles">
      <div class="section-heading">
        <div><div class="eyebrow">文章</div><h2>从这儿开始读。</h2></div>
        <div class="filters" aria-label="文章筛选">
          {(["全部", "配置指南", "基础原理", "科创情报", "个人杂项"] as const).map((filter, index) => (
            <button class="filter-button" type="button" data-filter={filter} aria-pressed={index === 0 ? "true" : "false"}>{filter}</button>
          ))}
        </div>
      </div>
      <div class="article-grid" id="articleGrid">
        {cards.map((entry) => (
          <ArticleCard
            id={entry.id}
            title={entry.data.title}
            description={entry.data.description}
            category={entry.data.category}
            readingMinutes={entry.data.readingMinutes}
            accent={entry.data.accent}
            featured={entry.data.featured}
            image={entry.data.image}
            imageAlt={entry.data.imageAlt}
            imageBlur={entry.data.imageBlur}
            imageBrightness={entry.data.imageBrightness}
            imagePosition={entry.data.imagePosition}
          />
        ))}
      </div>
    </section>
  </main>
  <script is:inline>
    document.querySelectorAll("[data-filter]").forEach((button) => button.addEventListener("click", () => {
      const filter = button.dataset.filter;
      document.querySelectorAll("[data-filter]").forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
      document.querySelectorAll(".article-card").forEach((card) => {
        card.hidden = filter !== "全部" && card.dataset.category !== filter;
      });
    }));
  </script>
</BaseLayout>
