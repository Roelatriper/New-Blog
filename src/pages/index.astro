---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleCard from "../components/ArticleCard.astro";

const entries = (await getCollection("articles", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
const mainGuide = {
  id: "cpp-environment",
  data: {
    title: "Windows 下的 C++ 环境怎么选？",
    description: "先判断比赛兼容、折腾意愿和项目规模，再进入对应的安装路线。",
    category: "配置指南",
    readingMinutes: 12,
    accent: "ink" as const,
    featured: true,
    image: undefined,
    imageAlt: "",
    imageBlur: 10,
    imageBrightness: 0.62,
    imagePosition: "center"
  }
};
const cards = [mainGuide, ...entries];
const base = import.meta.env.BASE_URL;
---

<BaseLayout>
  <main class="home-main shell">
    <section class="home-hero" id="about">
      <div class="hero-copy">
        <div class="hero-kicker"><span class="status-dot" aria-hidden="true"></span> 科创 · 代码 · 生活 <span class="hero-frequency" aria-hidden="true">39 / 01</span></div>
        <h1 id="hitokoto">已经很努力的加载了！...</h1>
        <script src="https://v1.hitokoto.cn/?encode=js&select=%23hitokoto" defer></script>
        <p class="lede">这儿收录我整理的科创情报、工具配置和杂。挑感兴趣的读。</p>
        <div class="hero-actions"><a class="primary-button" href="#articles">翻开笔记 <span aria-hidden="true">↘</span></a><a class="hero-about" href={`${base}articles/me/`}>认识一下我 ↗</a></div>
        <div class="hero-index"><span>{String(cards.length).padStart(2, "0")} 篇笔记</span><span>一点灵感，一点折腾。</span></div>
      </div>
      <aside class="miku-art-card" aria-label="风中的 Miku 插画">
        <div class="art-caption-top"><span>MIKU / 01</span><span>风往这边吹 ↗</span></div>
        <img src={`${base}images/miku/wind.webp`} width="850" height="850" alt="Miku！" fetchpriority="high" />
        <div class="art-caption-bottom"><div><span class="eyebrow">本站正在生长ing</span><strong>Divide et impera.</strong></div><span class="art-note">分而治之。<br /><span aria-hidden="true">♪ ━━━ 39</span></span></div>
      </aside>
    </section>

    <section id="articles">
      <div class="section-heading">
        <div><div class="eyebrow">笔记索引 / {String(cards.length).padStart(2, "0")}</div><h2>从这儿开始<span class="miku-period">。</span></h2><p><a class="guide-link" href={`${base}articles/cpp-environment/`}>有配置需求？从 C++ 环境选择指南开始 ↗</a></p></div>
        <div class="filters" aria-label="文章筛选">
          {(["全部", "配置指南", "基础原理", "科创情报", "个人杂谈"] as const).map((filter, index) => (
            <button class="filter-button" type="button" data-filter={filter} aria-pressed={index === 0 ? "true" : "false"}>{filter}</button>
          ))}
        </div>
      </div>
      <div class="article-grid" id="articleGrid">
        {cards.map((entry) => (
          <ArticleCard
            id={entry.id}
            title={entry.data.title}
            description={entry.data.description}
            category={entry.data.category}
            readingMinutes={entry.data.readingMinutes}
            accent={entry.data.accent}
            featured={entry.data.featured}
            image={entry.data.image}
            imageAlt={entry.data.imageAlt}
            imageBlur={entry.data.imageBlur}
            imageBrightness={entry.data.imageBrightness}
            imagePosition={entry.data.imagePosition}
          />
        ))}
      </div>
    </section>
  </main>
  <script is:inline>
    document.querySelectorAll("[data-filter]").forEach((button) => button.addEventListener("click", () => {
      const filter = button.dataset.filter;
      document.querySelectorAll("[data-filter]").forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
      document.querySelectorAll(".article-card").forEach((card) => {
        card.hidden = filter !== "全部" && card.dataset.category !== filter;
      });
    }));
  </script>
</BaseLayout>
