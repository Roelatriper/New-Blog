---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import EnvironmentChooser from "../../../components/EnvironmentChooser.astro";
import LessonProgress from "../../../components/LessonProgress.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Windows C++ 环境配置指南 · 白衣" description="从比赛兼容到现代工具链，只要顺手的都是好IDE.">
  <header class="article-header">
    <div class="eyebrow">配置指南 · Windows向</div>
    <h1>...都从微不足道开始。</h1>
    <p class="lede">慢慢来，这里可没有假道场的絮絮叨叨，打打杀杀。</p>
    <div class="article-meta"><span>适合第一次配置环境的读者</span><span>约 12 分钟完成选择与验收</span></div>
  </header>

  <div class="article-shell">
    <nav class="toc" aria-label="文章目录">
      <span class="toc-title">本文目录</span>
      <button type="button" data-jump="choose">01 选择路线</button>
      <button type="button" data-jump="install">02 安装配置</button>
      <button type="button" data-jump="verify">03 A+B 验收</button>
      <button type="button" data-jump="principles">04 理解原理</button>
    </nav>
    <article class="article-content">
      <section class="article-panel" id="choose" data-progress="0">
        <div class="eyebrow">01 · 选择路线</div>
        <h2>先问三个问题。</h2>
        <EnvironmentChooser />
        <div class="route-summary" id="routeSummary">还没有选择。你也可以直接查看下面四条路线。</div>
      </section>

      <section class="article-panel" id="install" data-progress="1">
        <div class="eyebrow">02 · 安装配置</div>
        <h2>进入对应教程。</h2>
        <p id="routeAdvice">谨记：十年OI一场空，不开long long见祖宗。</p>
        <div class="route-grid" id="routeGrid">
          <a class="route-card" data-route="redpanda-cpp" href={`${base}articles/redpanda-cpp/`}><strong>🐼 小熊猫 C++</strong><span>轻量、开箱即用，适合日常算法练习。</span></a>
          <a class="route-card" data-route="vscode-msys2" href={`${base}articles/vscode-msys2/`}><strong>⌘ VS Code + MSYS2</strong><span>愿意理解工具链时，灵活且可持续。</span></a>
          <a class="route-card" data-route="visual-studio-2026" href={`${base}articles/visual-studio-2026/`}><strong>∞ Visual Studio 2026</strong><span>完整 Windows C++ IDE，适合大型项目。</span></a>
          <a class="route-card" data-route="devcpp-competition" href={`${base}articles/devcpp-competition/`}><strong>🏁 Dev-C++ 5.11</strong><span>赛事明确指定时使用，不作为日常首选。</span></a>
        </div>
      </section>

      <section class="article-panel" id="verify" data-progress="2">
        <div class="eyebrow">03 · A+B 验收</div>
        <h2>用洛谷 P1001 验收</h2>
        <p>那么我们开始吧！用一道经典的A+B问题，开始你的Coding之路。</p>
        <pre class="code-block"><code>#include &lt;iostream&gt;
using namespace std;
int main() &#123;
int a, b;
cin &gt;&gt; a &gt;&gt; b;
cout &lt;&lt; a + b &lt;&lt; '\n';
return 0;
&#125;
</code></pre>
        <p><strong>本地运行验证：</strong>在你选择的软件里编译运行，输入 <code>1 2</code>，应当输出 <code>3</code>。想做在线评测，再把代码提交到 <a href="https://www.luogu.com.cn/problem/P1001" target="_blank" rel="noreferrer">洛谷 P1001</a>，以洛谷页面的结果为准。</p>
        <button class="primary-button" id="verifyButton" type="button">我在软件里跑通了！</button>
        <div class="success-message" id="verifyMessage" hidden>本地运行已完成！下一步，看看是谁让代码跑起来的。</div>
      </section>

      <section class="article-panel" id="principles" data-progress="3">
        <div class="eyebrow">04 · 理解原理</div>
        <h2>首先，别把编辑器当成编译器。</h2>
        <p>你写下的是源代码；编辑器能让你更舒服地写；编译器把代码翻译为机器能够执行的程序；而调试器帮助你观察程序运行过程。</p>
        <p>能理解吗？你可以这样理清这些玩意。</p>
        <div class="concept-flow"><div><b>源代码</b><span>.cpp 文件</span></div><div><b>编译器</b><span>g++ / MSVC</span></div><div><b>可执行程序</b><span>.exe 文件</span></div></div>
        <p><a href={`${base}articles/toolchain-basics/`}>继续阅读：编辑器、编译器和代码是什么关系 →</a></p>
      </section>

      <section class="article-panel" id="finish">
        <div class="eyebrow">完成</div>
        <h2>你已经有了一条可复现的路线。</h2>
        <p>保存你选择的教程链接。以后换电脑或帮助同学配置时，仍然从“选路线 → 装工具 → 跑 A+B → 看懂工具链”开始。</p>
        <button class="primary-button" id="finishButton" type="button">完成本篇教程</button>
        <div class="success-message" id="finishMessage" hidden>Wonderful Answer！现在你不仅能运行代码，也知道是谁让它跑起来的。</div>
      </section>
    </article>
  </div>
  <dialog class="route-confirm" id="routeConfirm" aria-labelledby="routeConfirmTitle" aria-describedby="routeConfirmDescription">
    <div class="eyebrow">切换教程</div>
    <h2 id="routeConfirmTitle">这不是你选择的 IDE！真的要继续吗？</h2>
    <p id="routeConfirmDescription"></p>
    <form method="dialog" class="button-row">
      <button class="primary-button" type="submit" value="continue">让我检查！</button>
      <button class="secondary-button" type="submit" value="cancel">算了</button>
    </form>
  </dialog>
  <section class="comments shell" aria-label="文章评论">
    <h2>想说些什么？</h2>
      <script is:inline src="https://giscus.app/client.js"
            data-repo="roelatriper/New-Blog"
            data-repo-id="R_kgDOUie9Wg"
            data-category="Q&A"
            data-category-id="DIC_kwDOUie9Ws4DGD7i"
            data-mapping="pathname"
            data-strict="0"
            data-reactions-enabled="1"
            data-emit-metadata="0"
            data-input-position="top"
            data-theme="preferred_color_scheme"
            data-lang="zh-CN"
            data-loading="lazy"
            crossorigin="anonymous"
            async>
    </script>
  </section>  
  <LessonProgress />
  <div class="confetti-layer" id="confettiLayer" aria-hidden="true"></div>

  <script is:inline>
    const celebrate = () => {
      const layer = document.querySelector("#confettiLayer");
      if (!layer) return;
      const glyphs = ["♪", "★", "●", "◆", "🥬", "✦"];
      const colors = ["#39c5bb", "#72e3d9", "#ffffff", "#ee7aa9", "#8278d7"];
      for (let i = 0; i < 72; i++) {
        const bit = document.createElement("span");
        bit.className = "confetti";
        bit.textContent = glyphs[i % glyphs.length];
        const angle = Math.PI * 2 * i / 72 + Math.random() * .2;
        const distance = 150 + Math.random() * 360;
        bit.style.setProperty("--x", `${Math.cos(angle) * distance}px`);
        bit.style.setProperty("--y", `${Math.sin(angle) * distance - 170}px`);
        bit.style.setProperty("--r", `${Math.random() * 900 - 450}deg`);
        bit.style.color = colors[i % colors.length];
        layer.appendChild(bit);
      }
      setTimeout(() => layer.replaceChildren(), 1450);
    };
    const routeGrid = document.querySelector("#routeGrid");
    const routeCards = [...document.querySelectorAll(".route-card[data-route]")];
    const routeConfirm = document.querySelector("#routeConfirm");
    let selectedRoute = null;
    let pendingCard = null;
    const applyRoute = (result) => {
      if (!routeCards.some((card) => card.dataset.route === result?.slug)) return;
      const summary = document.querySelector("#routeSummary");
      const advice = document.querySelector("#routeAdvice");
      if (summary) summary.textContent = `推荐路线：${result.name} · ${result.desc}`;
      if (advice) {
        const name = document.createElement("strong");
        name.textContent = result.name;
        advice.replaceChildren("已选好 ", name, "。点击对应卡片进入完整教程。");
      }
      selectedRoute = result.slug;
      routeGrid?.classList.add("has-selection");
      routeCards.forEach((card) => card.classList.toggle("is-selected", card.dataset.route === selectedRoute));
    };
    document.querySelectorAll("[data-jump]").forEach((button) => button.addEventListener("click", () => document.querySelector(`#${button.dataset.jump}`)?.scrollIntoView({ behavior: "smooth" })));
    window.addEventListener("baiyi:route", (event) => {
      applyRoute(event.detail);
      try { sessionStorage.setItem("baiyi:cpp-route", JSON.stringify(event.detail)); } catch {}
    });
    try {
      const savedRoute = JSON.parse(sessionStorage.getItem("baiyi:cpp-route") || "null");
      if (savedRoute) applyRoute(savedRoute);
    } catch {}
    routeCards.forEach((card) => card.addEventListener("click", (event) => {
      if (!selectedRoute || card.dataset.route === selectedRoute) return;
      event.preventDefault();
      pendingCard = card;
      const selectedName = routeCards.find((item) => item.dataset.route === selectedRoute)?.querySelector("strong")?.textContent?.trim();
      const nextName = card.querySelector("strong")?.textContent?.trim();
      const description = routeConfirm?.querySelector("#routeConfirmDescription");
      if (description) description.textContent = `你选择的是 ${selectedName}，现在准备查看 ${nextName} 方案。`;
      if (routeConfirm) {
        routeConfirm.returnValue = "";
        routeConfirm.showModal();
      }
    }));
    routeConfirm?.addEventListener("close", () => {
      const card = pendingCard;
      pendingCard = null;
      if (routeConfirm.returnValue === "continue" && card) window.location.assign(card.href);
      else card?.focus();
    });
    document.querySelector("#verifyButton")?.addEventListener("click", () => {
      document.querySelector("#verifyMessage")?.removeAttribute("hidden");
      window.dispatchEvent(new Event("baiyi:verified"));
      celebrate();
    });
    document.querySelector("#finishButton")?.addEventListener("click", () => {
      document.querySelector("#finishMessage")?.removeAttribute("hidden");
      window.dispatchEvent(new Event("baiyi:finished"));
      celebrate();
    });
  </script>
</BaseLayout>
